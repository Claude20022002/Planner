# ==================== BASE DE DONNÉES ====================
DB_NAME=hestim_planner
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql

# ==================== SERVEUR ====================
PORT=5000
NODE_ENV=development
# Fuseau de l'école (nom de la base des fuseaux, par exemple Africa/Kinshasa ou Europe/Paris) :
# « aujourd'hui », les heures de séance, l'appel du jour et les notifications en dépendent.
# Obligatoire en production : sans lui, le serveur refuse de démarrer. En développement, UTC (M-10).
APP_TIMEZONE=

# Origines autorisées pour CORS et la vérification CSRF (séparées par des virgules)
# En production : l'URL réelle du site (ex: https://planner.votre-ecole.example)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Nombre de proxys devant l'API (nginx = 1). Sert à lire la vraie IP client pour le rate limiting.
TRUST_PROXY_HOPS=1

# Seed de démonstration automatique si la base est vide (développement uniquement,
# ignoré en production). Comptes créés avec un mot de passe connu : ne jamais activer en prod.
SEED_ON_EMPTY=false

# ==================== JWT / SESSIONS ====================
# OBLIGATOIRE — Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Ancien secret HS256 : ne sert plus qu'à défaut de CSRF_SECRET (jetons d'accès en RS256, plus bas)
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_VALEUR_ALEATOIRE_LONGUE
# Secret distinct pour signer les jetons CSRF (sinon JWT_SECRET est utilisé)
CSRF_SECRET=CHANGEZ_MOI_AUSSI
# strict : frontend et API servis sur la même origine (proxy Vite en dev, nginx en prod)
COOKIE_SAMESITE=strict
# Durées : jeton d'accès (secondes) et session de renouvellement (jours)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Conservation du journal de sécurité, en jours (365 par défaut, 30 au minimum)
JOURNAL_SECURITE_JOURS=365

# Quiz générés par l'IA (docs/archives/plans/quiz-ia.md). Sans IA_CLE, la fonction est masquée.
# Aucune destination par défaut (docs/envois-sortants.md) : avec openai-compatible, la clé ne sert
# que si IA_URL et IA_MODELE sont réglés. Le démarrage du serveur dit ce qui manque.
# IA_FOURNISSEUR : openai-compatible (DeepSeek, Mistral, OpenAI, Groq…) ou anthropic
#   exemples d'adresses : https://api.deepseek.com/v1 (modèle deepseek-chat),
#   https://api.mistral.ai/v1 ; avec anthropic, IA_URL peut rester vide (api.anthropic.com)
IA_FOURNISSEUR=openai-compatible
IA_URL=
IA_CLE=
IA_MODELE=
# Images, voix et transcription du Studio : même règle, clé, modèle et adresse pour chaque nature
#   (IA_IMAGE_URL, IA_VOIX_URL, IA_TRANSCRIPTION_URL ; exemple : https://api.openai.com/v1)
# Délai maximal d'une réponse (millisecondes) et générations par enseignant et par jour
IA_DELAI_MS=90000
IA_GENERATIONS_PAR_JOUR=20

# URL du frontend, utilisée dans les liens envoyés par email (réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:5173

# ==================== EMAIL ====================
# Sans compte (SMTP_USER vide), aucun courriel ne part : il est écrit dans le journal.
# Avec un compte, le serveur doit être nommé : SMTP_HOST, ou EMAIL_SERVICE=gmail. Sinon, rien ne
# part et chaque courriel échoue (plus de serveur par défaut).
#   exemple : SMTP_HOST=smtp.gmail.com, avec un mot de passe d'application Gmail
EMAIL_SERVICE=smtp
EMAIL_FROM="Planner <votre-email@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
# Générer un mot de passe d'application Gmail : myaccount.google.com/apppasswords
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL

# ==================== CONNEXION UNIQUE (PHASE C) ====================
# Clé privée RSA des jetons d'accès (PEM sur une ligne, retours à la ligne écrits \n).
# Absente en développement : clé éphémère (les sessions tombent au redémarrage).
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out planner-jwt.pem
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEY=
# Jeton de service de la synchronisation StudyLib (GET /api/integration/referentiel)
INTEGRATION_TOKEN=
# API de StudyLib pour l'espace de cours (dépôt des supports d'une classe, liens des étudiants).
# Par défaut http://studylib:8080/api (réseau Docker). Aucun secret : Planner signe ses jetons.
STUDYLIB_API_URL=

# ==================== NOTIFICATIONS PUSH (PHASE D) ====================
# Notifications push de l'application mobile (Expo) : jeton d'accès Expo avec la « sécurité
# renforcée des push » activée dans le projet Expo (seul Planner peut alors envoyer)
EXPO_ACCESS_TOKEN=
# Ce que reçoit Expo : generique (par défaut), un texte qui ne nomme personne et le lien de l'écran ;
# complet, le titre et le texte de la notification (seulement si l'école le demande)
PUSH_CONTENU=generique

# ==================== GÉNÉRATION (TIMEFOLD) ====================
# Service solver/ (java -jar solver/target/hestim-solver.jar) et jeton partagé, 32 caractères au moins
SOLVER_URL=http://localhost:8080
SOLVER_TOKEN=CHANGEZ_MOI_32_CARACTERES_MINIMUM_ALEATOIRES

# ==================== DEVOIRS (LOT D-2) ====================
# Les devoirs sont fermés par défaut : l'école ne fait pour le moment que des jeux pédagogiques.
# « true » rouvre les routes /api/devoirs ; rallumer en même temps DEVOIRS_ACTIFS dans
# shared/fonctions.js (site et application), puis reconstruire le site.
DEVOIRS_ACTIFS=false

# ==================== ANNONCES DES ENSEIGNANTS (LOT EC-5) ====================
# Fermé par défaut : pas d'annonces écrites par les enseignants à leurs classes pour le moment.
# L'administration et les responsables de filière écrivent toujours ; tous lisent les annonces reçues.
# « true » rouvre l'envoi ; rallumer en même temps ANNONCES_ENSEIGNANTS_ACTIVES dans
# shared/fonctions.js (site), puis reconstruire le site.
ANNONCES_ENSEIGNANTS_ACTIVES=false

# ==================== BIBLIOTHÈQUE : STOCKAGE DES FICHIERS (BIB-05) ====================
# MinIO (S3) : un seul seau, un préfixe par école (ecoles/<école>/bibliotheque/<uid>).
# Clé propre à Planner, limitée à Get/Put/DeleteObject sur le seau et ListBucket : jamais la clé root.
# Sans S3_ENDPOINT ou sans clé, la Bibliothèque répond « pas encore configurée » (503), sans rien tenter.
S3_ENDPOINT=http://localhost:9000
# Adresse signée dans les liens de téléchargement, celle que le navigateur ouvre (adresse publique des fichiers)
S3_ADRESSE_PUBLIQUE=http://localhost:9000
S3_REGION=us-east-1
S3_SEAU=planner
S3_CLE_ACCES=
S3_CLE_SECRETE=
