---
// Page « Bibliothèque » : les documents de l'école (StudyLib), sans capture. Les prêts de livres
// n'y figurent pas : ils n'existent pas.
import { BookOpen, ShieldCheck, Download, MessagesSquare, Video, Sparkles } from 'lucide-react';
import Gabarit from '../../components/socle/Gabarit.astro';
import EnTetePage from '../../components/fonctions/EnTetePage.astro';
import GrilleCartes from '../../components/fonctions/GrilleCartes.astro';
import FinDePage from '../../components/fonctions/FinDePage.astro';
import { traductions } from '../../i18n/index.js';
import { LANGUES } from '../../i18n/langues.js';

export const getStaticPaths = () => LANGUES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
const t = traductions(lang, 'bibliotheque');
---
<Gabarit langue={lang} page="bibliotheque" titre={t('meta.titre')} description={t('meta.description')}>
  <EnTetePage surtitre={t('entete.surtitre')} titre={t('entete.titre')} accroche={t('entete.accroche')} />
  <GrilleCartes id="documents" ton="gris" surtitre={t('documents.surtitre')} titre={t('documents.titre')} cartes={t('documents.cartes')}
    icones={[BookOpen, ShieldCheck, Download, MessagesSquare, Video, Sparkles]} />
  <FinDePage langue={lang} />
</Gabarit>
