---
// Page « Pour l'établissement », dans chaque langue : les statistiques, puis ce que la scolarité
// gère au quotidien (salles, examens, campus, import, comptes, identité de l'école). Assemble seulement.
import { DoorOpen, ClipboardCheck, MapPinned, FileSpreadsheet, UsersRound, Palette } from 'lucide-react';
import Gabarit from '../../components/socle/Gabarit.astro';
import CadreAppareil from '../../components/socle/CadreAppareil.astro';
import EnTetePage from '../../components/fonctions/EnTetePage.astro';
import Presentation from '../../components/fonctions/Presentation.astro';
import GrilleCartes from '../../components/fonctions/GrilleCartes.astro';
import FinDePage from '../../components/fonctions/FinDePage.astro';
import IllustrationStatistiques from '../../components/fonctions/IllustrationStatistiques.astro';
import { traductions } from '../../i18n/index.js';
import { cheminsLangues } from '../../i18n/langues.js';

export const getStaticPaths = cheminsLangues;

const { lang } = Astro.params;
const t = traductions(lang, 'etablissement');
---
<Gabarit langue={lang} page="etablissement" titre={t('meta.titre')} description={t('meta.description')}>
  <EnTetePage surtitre={t('entete.surtitre')} titre={t('entete.titre')} accroche={t('entete.accroche')} />
  <Presentation id="statistiques" ton="gris" surtitre={t('statistiques.surtitre')} titre={t('statistiques.titre')}
    texte={t('statistiques.texte')} points={t('statistiques.points')}>
    <CadreAppareil type="ordinateur" label={t('statistiques.illustration.label')}>
      <IllustrationStatistiques t={t} />
    </CadreAppareil>
  </Presentation>
  <GrilleCartes id="quotidien" surtitre={t('quotidien.surtitre')} titre={t('quotidien.titre')} cartes={t('quotidien.cartes')}
    icones={[DoorOpen, ClipboardCheck, MapPinned, FileSpreadsheet, UsersRound, Palette]} />
  <FinDePage langue={lang} />
</Gabarit>
