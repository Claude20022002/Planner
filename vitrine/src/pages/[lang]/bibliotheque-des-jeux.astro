---
// Bibliothèque des jeux : une grille par cycle, puis par domaine. On n'y joue pas.
// Les deux images de Codex manquent : ces cartes s'affichent sans image.
import fs from 'node:fs';
import path from 'node:path';
import Gabarit from '../../components/socle/Gabarit.astro';
import EnTetePage from '../../components/fonctions/EnTetePage.astro';
import CartesJeux from '../../components/jeux/CartesJeux.astro';
import FinDePage from '../../components/fonctions/FinDePage.astro';
import { traductions } from '../../i18n/index.js';
import { cheminsLangues } from '../../i18n/langues.js';
import { IMAGE_DE_PAGE } from '../../components/socle/illustrations.js';

export const getStaticPaths = cheminsLangues;

const { lang } = Astro.params;
const t = traductions(lang, 'bibliotheque-des-jeux');
const vue = (code: string) => {
  const fichier = path.join(process.cwd(), 'public', 'jeux', `${code}.webp`);
  return fs.existsSync(fichier) ? `/jeux/${code}.webp` : '';
};
const groupes = t('jeux.groupes').map((groupe: { cycle: string; domaine: string; cartes: { code: string; titre: string; accroche: string }[] }, index: number) => ({
  id: `jeux-${groupe.cycle}-${groupe.domaine}`,
  surtitre: t('cycles')[groupe.cycle],
  titre: t('domaines')[groupe.domaine],
  ton: index % 2 === 0 ? 'gris' : 'clair',
  cartes: groupe.cartes.map((carte) => ({
    ...carte,
    domaine: t('domaines')[groupe.domaine],
    image: vue(carte.code),
  })),
}));
---
<Gabarit langue={lang} page="bibliothequeJeux" titre={t('meta.titre')} description={t('meta.description')}>
  <EnTetePage surtitre={t('entete.surtitre')} titre={t('entete.titre')} accroche={t('entete.accroche')} relief={t('entete').relief} image={IMAGE_DE_PAGE['bibliotheque-des-jeux']} />
  {groupes.map((groupe) => (
    <CartesJeux id={groupe.id} ton={groupe.ton} surtitre={groupe.surtitre} titre={groupe.titre} cartes={groupe.cartes} />
  ))}
  <FinDePage langue={lang} />
</Gabarit>
