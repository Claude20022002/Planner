---
 // Catalogue statique des fonctionnalités, classées par application puis par catégorie.
import Gabarit from '../../components/socle/Gabarit.astro';
import Catalogue from '../../components/catalogue/Catalogue.astro';
import { LANGUES } from '../../i18n/langues.js';
import { traductions } from '../../i18n/index.js';

export const getStaticPaths = () => LANGUES.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const t = traductions(lang, 'fonctionnalites');
---
<Gabarit langue={lang} page="fonctionnalites" titre={t('titre') + ' · Planner'} description={t('description')}>
  <Catalogue langue={lang} />
</Gabarit>
