---
 // Navigation des fonctionnalités. Le navigateur gère l’ouverture, le focus et la fermeture.
import { fonctionnalites, regrouper } from './registre.js';
import { chemin, FONCTIONS } from '../../i18n/langues.js';
import { traductions } from '../../i18n/index.js';

const { langue, page } = Astro.props;
const t = traductions(langue, 'fonctionnalites');
const commun = traductions(langue, 'commun');
const faq = traductions(langue, 'faq');
const groupes = Array.from(regrouper(fonctionnalites(langue), 'categorie'));
const actif = FONCTIONS.includes(page) || ['fonctionnalites', 'faq'].includes(page);
---
<a class="repli" href={chemin(langue, 'fonctionnalites')}>{commun('navigation.fonctions')}</a>
<button class:list={['ouvrir', { actif }]} type="button" popovertarget="menu-fonctions">
  {commun('navigation.fonctions')}
</button>
<div popover="auto" id="menu-fonctions" class="panneau" aria-label={commun('navigation.fonctions')} role="region">
  <div class="outils">
    <a href={chemin(langue, 'fonctionnalites')} aria-current={page === 'fonctionnalites' ? 'page' : undefined}>{t('titre')}</a>
    <button type="button" popovertarget="menu-fonctions" popovertargetaction="hide">{t('fermer')}</button>
  </div>
  <div class="colonnes">
    <ul class="index" aria-label={t('categories')}>
      {groupes.map(([cle, entrees]) => (
        <li><a href={'#menu-' + cle}>{t('groupes.' + cle)} <span>{entrees.length}</span></a></li>
      ))}
    </ul>
    <div class="groupes">
      {groupes.map(([cle, entrees]) => (
        <section>
          <h2 id={'menu-' + cle} tabindex="-1">{t('groupes.' + cle)} <span>({entrees.length})</span></h2>
          <ul>{entrees.map((entree) => (
            <li><a href={chemin(langue, entree.page)}>{entree.titre}
              {entree.etat === 'bientot' && <small> · {commun('navigation.bientot')}</small>}
            </a></li>
          ))}</ul>
        </section>
      ))}
      <a class="faq" href={chemin(langue, 'faq')} aria-current={page === 'faq' ? 'page' : undefined}>{faq('titre')}</a>
    </div>
  </div>
</div>

<style>
  .ouvrir, .panneau { display: none; }
  @supports selector(:popover-open) {
    .repli { display: none; }
    .ouvrir { display: inline-flex; align-items: center; gap: .4rem; }
    .panneau:popover-open { display: block; }
  }
  .ouvrir, .outils button { font: inherit; color: inherit; background: transparent; border: 0; padding: 0; cursor: pointer; }
  .ouvrir.actif, a[aria-current='page'] { color: var(--bleu-profond); }
  .ouvrir::after { content: ''; inline-size: .42rem; block-size: .42rem; border-block-end: 1.5px solid; border-inline-end: 1.5px solid; transform: translateY(-.1rem) rotate(45deg); }
  :global([dir=rtl]) .ouvrir::after { transform: translateY(-.1rem) rotate(-45deg); }
  .panneau { position: fixed; inset: auto 0; inset-block-start: var(--hauteur-entete); margin: 0 auto;
    inline-size: min(46rem, calc(100% - 1rem)); max-block-size: calc(100% - var(--hauteur-entete) - .5rem);
    overflow: auto; overscroll-behavior: contain; color: var(--encre); background: var(--blanc);
    padding: 0; border: 1px solid var(--gris-trait); border-radius: var(--rayon-petit);
    font-size: 1rem; font-weight: 450; line-height: 1.5; }
  .outils, .colonnes { padding: 1rem 1.25rem; }
  .outils { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-block-end: 1px solid var(--gris-trait); }
  .panneau a { color: inherit; text-decoration: none; }
  .panneau a:hover, .outils button:hover { text-decoration: underline; }
  .outils a, .faq { font-weight: 650; color: var(--bleu-profond); }
  .outils button { min-block-size: 2.5rem; font-size: var(--texte-petit); }
  .index { display: none; }
  section + section, .faq { margin-block-start: 1.25rem; }
  h2 { font-size: 1.05rem; color: var(--bleu-nuit); }
  h2 span, .index span, small { font-weight: 450; color: var(--gris-texte); }
  .groupes li a, .faq { display: inline-block; padding-block: .35rem; }
  @media (min-width: 64rem) {
    .colonnes { display: grid; grid-template-columns: 2fr 3fr; gap: 2rem; }
    .index { display: block; }
    .index a { display: flex; justify-content: space-between; gap: .75rem; padding-block: .35rem; }
  }
</style>
