---
// « Un besoin, une application. » (plan VIT-20, § 4.4, point 7) : les autres modules disponibles, puis « Toutes les applications ».
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import TuileModule from './TuileModule.astro';
import { traductions } from '../../i18n/index.js';
import { chemin } from '../../i18n/langues.js';
import { modulesDisponibles } from '../../donnees/modules.js';

interface Props {
  langue: string;
  cle: string;
}

const { langue, cle } = Astro.props;
const commun = traductions(langue, 'commun');
const autres = modulesDisponibles().filter((module) => module.cle !== cle);
---
<Section id="autres-applications" ton="gris" large etiquette="autres-titre">
  <Titre id="autres-titre" taille="moyen">{commun('navigation.unBesoin')}</Titre>
  {autres.length > 0 && (
    <ul class="grille">
      {autres.map((module) => <li><TuileModule module={module} langue={langue} compacte /></li>)}
    </ul>
  )}
  <BoutonPrincipal href={chemin(langue, 'applications')} variante="lien">{commun('navigation.toutesLesApplications')}</BoutonPrincipal>
</Section>

<style>
  .grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-2);
    inline-size: 100%;
    max-inline-size: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grille > li { display: grid; }
  @media (min-width: 48rem) { .grille { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
