---
// Ouverture d'une page de module (plan VIT-20, § 4.4 ; mise en page de VIT-23) : onglets « Aperçu » et « Fonctionnalités » en tête
// (et ceux que la page ajoute), puis logo, catégorie, nom (le h1), accroche, bouton de démonstration, et l'illustration du module.
import OuverturePage from '../socle/OuverturePage.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import { IMAGE_DU_MODULE } from '../socle/illustrations.js';
import { logoModule } from './logos.js';
import { cheminContact } from '../../i18n/langues.js';

interface Props {
  langue: string;
  module: { cle: string; logo: string | null };
  surtitre: string;
  titre: string;
  accroche: string;
  demonstration: string;
  onglets: { href: string; texte: string; actif?: boolean }[];
  disposition?: 'cote' | 'dessous';
}

const { langue, module, surtitre, titre, accroche, demonstration, onglets, disposition } = Astro.props;
---
<OuverturePage id="page-titre" surtitre={surtitre} titre={titre} accroche={accroche} image={IMAGE_DU_MODULE[module.cle]} disposition={disposition}>
  <ul class="onglets" slot="haut">
    {onglets.map((onglet) => (
      <li><a href={onglet.href} aria-current={onglet.actif ? 'page' : undefined}>{onglet.texte}</a></li>
    ))}
  </ul>
  <span class="logo" slot="marque" set:html={logoModule(module)} />
  <BoutonPrincipal slot="actions" href={cheminContact(langue)}>{demonstration}</BoutonPrincipal>
</OuverturePage>

<style>
  .logo { display: block; inline-size: 4.5rem; }
  .logo :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .onglets { display: flex; flex-wrap: wrap; gap: var(--espace-1); margin: 0; padding: 0; list-style: none; }
  .onglets a {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: var(--rayon-pilule);
    color: var(--encre);
    font-weight: 500;
    text-decoration: none;
  }
  .onglets a:hover { background: var(--gris-fond); }
  .onglets a[aria-current='page'] { background: var(--bleu); color: var(--blanc); }
</style>
