---
// Grille des modules : les disponibles d'abord (logo, nom, lien), puis les tuiles grisées « Bientôt ». Sur « Toutes les
// applications », `parCategorie` range les 17 sous leurs quatre catégories. Posée sur l'accueil et sur /applications/.
import TuileModule from './TuileModule.astro';
import { traductions } from '../../i18n/index.js';
import { CATEGORIES, MODULES, estDisponible, modulesDeCategorie } from '../../donnees/modules.js';

interface Props {
  langue: string;
  parCategorie?: boolean;
  niveauTitre?: 2 | 3;
}

const { langue, parCategorie = false, niveauTitre = 2 } = Astro.props;
const commun = traductions(langue, 'commun');
const Titre = `h${niveauTitre}`;
const disponibles = MODULES.filter(estDisponible);
const bientot = MODULES.filter((module) => !estDisponible(module));
---
{parCategorie ? (
  <div class="categories">
    {CATEGORIES.map((categorie) => (
      <section aria-labelledby={`categorie-${categorie}`}>
        <Titre id={`categorie-${categorie}`}>{commun(`categories.${categorie}`)}</Titre>
        <ul class="grille">
          {modulesDeCategorie(categorie).map((module) => <li><TuileModule module={module} langue={langue} compacte /></li>)}
        </ul>
      </section>
    ))}
  </div>
) : (
  <ul class="grille">
    {[...disponibles, ...bientot].map((module) => <li><TuileModule module={module} langue={langue} compacte /></li>)}
  </ul>
)}

<style>
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr));
    gap: var(--espace-2);
    inline-size: 100%;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .grille, .categories { min-inline-size: 0; max-inline-size: 58rem; margin-inline: auto; }
  .grille > li { display: grid; min-inline-size: 0; }
  .categories { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--espace-4); inline-size: 100%; text-align: start; }
  .categories :global(h2), .categories :global(h3) { margin: 0 0 var(--espace-2); font-size: var(--texte-accroche); color: var(--bleu-nuit); }
</style>
