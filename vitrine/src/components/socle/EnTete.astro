---
// En-tête du site vitrine (plan VIT-20, § 4.2) : logo, trois menus (Applications, Établissements, Ressources), Contact, langues,
// « Se connecter » (rendu seulement si l'adresse de l'application est fixée) et « Demander une démonstration ».
// Les menus sont des <details> : clavier et toucher sans JavaScript. Sur téléphone, un bouton replie la navigation ;
// sans JavaScript, le bouton reste caché et la navigation s'affiche en entier sous la barre.
import { Menu } from 'lucide-react';
import Logo from './Logo.astro';
import MenuApplications from '../navigation/MenuApplications.astro';
import MenuEtablissements from '../navigation/MenuEtablissements.astro';
import MenuRessources from '../navigation/MenuRessources.astro';
import { traductions } from '../../i18n/index.js';
import { ADRESSE_APPLICATION } from '../../donnees/site.js';
import { LANGUES_PUBLIEES, PREFIXE_MODULE, chemin, cheminContact } from '../../i18n/langues.js';

interface Props {
  langue: string;
  page: string;
}

const { langue, page } = Astro.props;
const t = traductions(langue, 'commun');
const applicationsActif = page.startsWith(PREFIXE_MODULE) || page === 'applications' || page === 'socle';
---
<header class="entete">
  <div class="barre">
    <a class="marque" href={chemin(langue)} aria-label={t('logo')}>
      <Logo class="marque-logo" />
      <span aria-hidden="true">{t('produit')}</span>
    </a>
    <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="navigation-principale" hidden>
      <Menu aria-hidden="true" size={22} strokeWidth={1.75} />
      <span class="visuellement-cache">{t('navigation.menu')}</span>
    </button>
    <nav class="navigation" id="navigation-principale" aria-label={t('navigation.label')}>
      <ul class="liens">
        <li><MenuApplications langue={langue} actif={applicationsActif} /></li>
        <li><MenuEtablissements langue={langue} page={page} /></li>
        <li><MenuRessources langue={langue} page={page} /></li>
        <li><a href={cheminContact(langue)}>{t('navigation.contactLien')}</a></li>
      </ul>
      <ul class="langues" aria-label={t('langues.label')}>
        {LANGUES_PUBLIEES.map((l) => (
          <li>
            <a href={chemin(l, page)} hreflang={l} lang={l} aria-current={l === langue ? 'true' : undefined}>{t(`langues.${l}`)}</a>
          </li>
        ))}
      </ul>
      {ADRESSE_APPLICATION && <a class="connexion" href={ADRESSE_APPLICATION}>{t('navigation.seConnecter')}</a>}
      <a class="contact" href={cheminContact(langue)}>{t('navigation.demonstration')}</a>
    </nav>
  </div>
</header>
<script is:inline>
  // VIT-17 C6 : avant le premier rendu du contenu, pour éviter le saut du menu (condition 12).
  (function () {
    const entete = document.currentScript && document.currentScript.previousElementSibling;
    if (!entete || !entete.classList.contains('entete')) return;
    entete.classList.add('repliable');
    const bouton = entete.querySelector('.menu-bouton');
    if (bouton) bouton.hidden = false;
  })();
</script>

<script>
  // Menu repliable sur téléphone : le bouton n'apparaît qu'avec JavaScript
  const entete = document.querySelector('.entete');
  const bouton = entete?.querySelector('.menu-bouton');
  if (entete && bouton) {
    bouton.addEventListener('click', () => {
      const ouvert = bouton.getAttribute('aria-expanded') === 'true';
      bouton.setAttribute('aria-expanded', String(!ouvert));
    });
  }
  // Un seul menu ouvert à la fois ; Échap et un clic ailleurs le ferment, Échap rend le focus à son titre.
  const menus = () => Array.from(document.querySelectorAll('.entete details[open]'));
  document.addEventListener('keydown', (evenement) => {
    if (evenement.key !== 'Escape') return;
    menus().forEach((menu) => {
      menu.removeAttribute('open');
      menu.querySelector('summary')?.focus();
    });
  });
  document.addEventListener('click', (evenement) => {
    menus().forEach((menu) => { if (!menu.contains(evenement.target as Node)) menu.removeAttribute('open'); });
  });
  document.querySelectorAll('.entete details').forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if ((menu as HTMLDetailsElement).open) menus().forEach((autre) => { if (autre !== menu) autre.removeAttribute('open'); });
    });
  });
</script>

<style>
  .entete {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: rgb(255 255 255 / 96%);
    backdrop-filter: saturate(180%) blur(18px);
    border-block-end: 1px solid rgb(23 57 92 / 8%);
  }
  .barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--espace-3);
    max-inline-size: var(--largeur-contenu);
    min-block-size: var(--hauteur-entete);
    margin-inline: auto;
    padding-inline: var(--gouttiere);
  }
  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: var(--hauteur-entete);
    font-weight: 650;
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--bleu-nuit);
  }
  .marque :global(.marque-logo) { inline-size: 2rem; }
  .menu-bouton {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--encre);
    cursor: pointer;
    border-radius: var(--rayon-petit);
  }
  .menu-bouton[hidden] { display: none; }
  .navigation { flex-basis: 100%; display: grid; gap: var(--espace-3); padding-block: var(--espace-2) var(--espace-4); }
  .repliable .menu-bouton[aria-expanded='false'] + .navigation { display: none; }
  .liens { display: grid; gap: var(--espace-2); font-size: 1.25rem; font-weight: 600; }
  .liens a, .langues a { text-decoration: none; }
  .langues { display: flex; gap: var(--espace-3); font-size: var(--texte-petit); color: var(--gris-texte); }
  .langues a[aria-current='true'] { color: var(--encre); font-weight: 600; }
  .connexion { justify-self: start; font-size: var(--texte-petit); font-weight: 600; color: var(--bleu-profond); text-decoration: none; }
  .connexion:hover { text-decoration: underline; }
  .barre { position: relative; }
  .contact {
    justify-self: start;
    padding: 0.5rem 1rem;
    border-radius: var(--rayon-pilule);
    background: var(--bleu);
    color: var(--blanc);
    font-size: var(--texte-petit);
    font-weight: 600;
    text-decoration: none;
  }
  .contact:hover { background: var(--bleu-profond); }
  .liens a:hover, .langues a:hover { color: var(--bleu); }

  @media (max-width: 63.99rem) {
    .entete:not(.repliable), .entete:has(.menu-bouton[aria-expanded='true']) { position: relative; }
  }
  @media (min-width: 64rem) {
    .barre { flex-wrap: nowrap; }
    .menu-bouton, .repliable .menu-bouton { display: none; }
    .navigation, .repliable .menu-bouton[aria-expanded='false'] + .navigation {
      flex-basis: auto;
      display: flex;
      align-items: center;
      gap: var(--espace-4);
      padding: 0;
    }
    .liens { display: flex; align-items: center; gap: var(--espace-3); font-size: var(--texte-petit); font-weight: 450; }
    .langues { gap: var(--espace-2); font-size: 0.8125rem; }
  }
</style>
