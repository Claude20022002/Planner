---
// En-tête du site vitrine : logo et nom, navigation entre les pages, langue, lien de contact.
// Barre fixe et translucide. « Fonctions » est un menu details, lisible sans JavaScript.
// Sur téléphone, un bouton replie la navigation ; sans JavaScript, le bouton reste caché
// et la navigation s'affiche en entier sous la barre.
import { Briefcase, Landmark, Menu, School } from 'lucide-react';
import Logo from './Logo.astro';
import { TYPES } from '../solutions/types.js';
import { traductions } from '../../i18n/index.js';
import { LANGUES_PUBLIEES, BARRE, FONCTIONS, ROLES, chemin } from '../../i18n/langues.js';

interface Props {
  langue: string;
  page: string;
}

const { langue, page } = Astro.props;
const t = traductions(langue, 'commun');
const solutions = traductions(langue, 'solutions');
const iconesTypes = [School, Landmark, Briefcase];
const menuSolutions = page === 'solutions' || ROLES.includes(page);
---
<header class="entete">
  <div class="barre">
    <a class="marque" href={chemin(langue)} aria-label={t('logo')}>
      <Logo class="marque-logo" />
      <span aria-hidden="true">{t('produit')}</span>
    </a>
    <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="navigation-principale" hidden>
      <Menu aria-hidden="true" size={22} strokeWidth={1.75} />
      <span class="visuellement-cache">{t('navigation.menu')}</span>
    </button>
    <nav class="navigation" id="navigation-principale" aria-label={t('navigation.label')}>
      <ul class="liens">
        <li>
          <details class="fonctions solutions">
            <summary aria-current={menuSolutions ? 'page' : undefined}>{t('navigation.solutions')}</summary>
            <div class="panneau">
              <div>
                <p>{t('navigation.parEtablissement')}</p>
                <ul>
                  {TYPES.map(({ cle, ancre }, i) => {
                    const Icone = iconesTypes[i];
                    return (
                      <li>
                        <a href={chemin(langue, 'solutions', ancre)}>
                          <Icone aria-hidden="true" size={18} strokeWidth={1.75} />
                          {solutions(`types.${cle}.surtitre`)}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
              <div>
                <p>{t('navigation.parRole')}</p>
                <ul>
                  {ROLES.map((cle) => (
                    <li>
                      <a href={chemin(langue, cle)} aria-current={cle === page ? 'page' : undefined}>{t(`navigation.${cle}`)}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        </li>
        <li>
          <details class="fonctions">
            <summary aria-current={FONCTIONS.includes(page) ? 'page' : undefined}>{t('navigation.fonctions')}</summary>
            <ul>
              {FONCTIONS.map((cle) => (
                <li>
                  <a href={chemin(langue, cle)} aria-current={cle === page ? 'page' : undefined}>{t(`navigation.${cle}`)}</a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        {BARRE.filter((cle) => cle !== 'solutions').map((cle) => (
          <li>
            <a href={chemin(langue, cle)} aria-current={cle === page ? 'page' : undefined}>{t(`navigation.${cle}`)}</a>
          </li>
        ))}
      </ul>
      <ul class="langues" aria-label={t('langues.label')}>
        {LANGUES_PUBLIEES.map((l) => (
          <li>
            <a href={chemin(l, page)} hreflang={l} lang={l} aria-current={l === langue ? 'true' : undefined}>{t(`langues.${l}`)}</a>
          </li>
        ))}
      </ul>
      <a class="contact" href={chemin(langue, 'accueil', 'contact')}>{t('navigation.contact')}</a>
    </nav>
  </div>
</header>

<script>
  // Menu repliable sur téléphone : le bouton n'apparaît qu'avec JavaScript
  const entete = document.querySelector('.entete');
  const bouton = entete?.querySelector('.menu-bouton');
  if (entete && bouton) {
    entete.classList.add('repliable');
    bouton.hidden = false;
    bouton.addEventListener('click', () => {
      const ouvert = bouton.getAttribute('aria-expanded') === 'true';
      bouton.setAttribute('aria-expanded', String(!ouvert));
    });
  }
  document.addEventListener('keydown', (evenement) => {
    if (evenement.key !== 'Escape') return;
    document.querySelectorAll('.entete details[open]').forEach((menu) => menu.removeAttribute('open'));
  });
</script>

<style>
  .entete {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: rgb(255 255 255 / 82%);
    backdrop-filter: saturate(180%) blur(18px);
    border-block-end: 1px solid rgb(23 57 92 / 8%);
  }
  .barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--espace-3);
    max-inline-size: var(--largeur-contenu);
    min-block-size: var(--hauteur-entete);
    margin-inline: auto;
    padding-inline: var(--gouttiere);
  }
  .marque { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: var(--hauteur-entete); font-weight: 650; font-size: 1.0625rem; text-decoration: none; color: var(--bleu-nuit); }
  .marque :global(.marque-logo) { inline-size: 2rem; }
  .menu-bouton { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; padding: 0; border: 0; background: none; color: var(--encre); cursor: pointer; border-radius: var(--rayon-petit); }
  .menu-bouton[hidden] { display: none; }
  .navigation { flex-basis: 100%; display: grid; gap: var(--espace-3); padding-block: var(--espace-2) var(--espace-4); }
  .repliable .menu-bouton[aria-expanded='false'] + .navigation { display: none; }
  .liens { display: grid; gap: var(--espace-2); font-size: 1.25rem; font-weight: 600; }
  .liens a, .langues a { text-decoration: none; }
  .liens a[aria-current='page'], .fonctions summary[aria-current='page'] { color: var(--bleu); }
  .fonctions summary { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; list-style: none; }
  .fonctions summary::-webkit-details-marker { display: none; }
  .fonctions summary::after { content: ''; inline-size: 0.4rem; block-size: 0.4rem; border-inline-end: 1.5px solid currentColor; border-block-end: 1.5px solid currentColor; transform: translateY(-0.1rem) rotate(45deg); }
  .fonctions[open] summary::after { transform: translateY(0.1rem) rotate(225deg); }
  .fonctions > ul, .solutions .panneau ul { display: grid; gap: 0.5rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .solutions .panneau { display: grid; gap: var(--espace-3); }
  .solutions .panneau p { margin: 0.75rem 0 0; font-size: 0.8125rem; font-weight: 600; color: var(--gris-texte); }
  .solutions .panneau a { display: inline-flex; align-items: center; gap: 0.5rem; }
  .langues { display: flex; gap: var(--espace-3); font-size: var(--texte-petit); color: var(--gris-texte); }
  .langues a[aria-current='true'] { color: var(--encre); font-weight: 600; }
  .contact { justify-self: start; padding: 0.5rem 1rem; border-radius: var(--rayon-pilule); background: var(--bleu); color: var(--blanc); font-size: var(--texte-petit); font-weight: 600; text-decoration: none; }
  .contact:hover { background: var(--bleu-profond); }
  .liens a:hover, .langues a:hover { color: var(--bleu); }

  @media (min-width: 64rem) {
    .barre { flex-wrap: nowrap; }
    .menu-bouton, .repliable .menu-bouton { display: none; }
    .navigation, .repliable .menu-bouton[aria-expanded='false'] + .navigation { flex-basis: auto; display: flex; align-items: center; gap: var(--espace-4); padding: 0; }
    .liens { display: flex; align-items: center; gap: var(--espace-3); font-size: var(--texte-petit); font-weight: 450; }
    .fonctions { position: relative; }
    .fonctions > ul { position: absolute; z-index: 60; inset-inline-start: 0; inset-block-start: calc(100% + 0.35rem); min-inline-size: 14rem; max-inline-size: min(18rem, calc(100vw - 2 * var(--gouttiere))); margin: 0; padding: 0.75rem 1rem; background: var(--blanc); border: 1px solid rgb(23 57 92 / 12%); border-radius: var(--rayon-petit); }
    .solutions .panneau { position: absolute; z-index: 60; inset-inline-start: 0; inset-block-start: calc(100% + 0.35rem); grid-template-columns: repeat(2, minmax(12rem, 1fr)); gap: var(--espace-4); inline-size: max-content; max-inline-size: calc(100vw - 2 * var(--gouttiere)); margin: 0; padding: 0.5rem 1.25rem 1rem; background: var(--blanc); border: 1px solid rgb(23 57 92 / 12%); border-radius: var(--rayon-petit); }
    .fonctions > ul a, .solutions .panneau a { white-space: nowrap; }
    .langues { gap: var(--espace-2); font-size: 0.8125rem; }
  }
</style>
