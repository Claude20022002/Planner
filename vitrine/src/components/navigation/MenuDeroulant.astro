---
// Menu déroulant de la barre (plan VIT-20, § 4.2) : un <details> natif, donc ouvert au clavier (Entrée, Espace) et au toucher sans
// JavaScript. Le panneau est replié dans le menu du téléphone ; sur ordinateur il flotte sous la barre. « large » : il s'étend
// sur toute la largeur de la barre (menu Applications). Fermeture par Échap et clic ailleurs : script de EnTete.astro.
interface Props {
  libelle: string;
  actif?: boolean;
  large?: boolean;
}

const { libelle, actif = false, large = false } = Astro.props;
---
<details class:list={['menu', { large }]}>
  <summary aria-current={actif ? 'page' : undefined}>{libelle}</summary>
  <div class="panneau"><slot /></div>
</details>

<style>
  .menu summary { display: flex; align-items: center; gap: 0.35rem; cursor: pointer; list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after { content: ''; inline-size: 0.4rem; block-size: 0.4rem; border-inline-end: 1.5px solid currentColor; border-block-end: 1.5px solid currentColor; transform: translateY(-0.1rem) rotate(45deg); }
  .menu[open] summary::after { transform: translateY(0.1rem) rotate(225deg); }
  .menu summary[aria-current='page'] { color: var(--bleu); }
  .panneau { display: grid; gap: var(--espace-3); padding-block: var(--espace-1); font-size: var(--texte-petit); font-weight: 450; }
  .panneau :global(h2), .panneau :global(p.titre) { margin: 0.75rem 0 0; font-size: 0.8125rem; font-weight: 600; color: var(--gris-texte); }
  .panneau :global(ul) { display: grid; gap: 0.5rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .panneau :global(a) { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--encre); text-decoration: none; }
  .panneau :global(a:hover) { color: var(--bleu); text-decoration: underline; }
  .panneau :global(a[aria-current='page']) { color: var(--bleu); }

  @media (min-width: 64rem) {
    .menu:not(.large) { position: relative; }
    .panneau { position: absolute; z-index: 60; inset-block-start: calc(100% + 0.35rem); inset-inline-start: 0; inline-size: max-content;
      max-inline-size: calc(100vw - 2 * var(--gouttiere)); padding: 0.5rem 1.25rem 1rem; background: var(--blanc);
      border: 1px solid rgb(23 57 92 / 12%); border-radius: var(--rayon-petit); box-shadow: var(--ombre-carte); }
    .menu:not(.large) .panneau { grid-template-columns: repeat(2, minmax(12rem, 1fr)); gap: var(--espace-4); }
    .menu.large .panneau { inset-inline: var(--gouttiere); inline-size: auto; max-inline-size: none; }
    .panneau :global(a) { white-space: nowrap; }
  }
</style>
