---
// Accueil, dernière section : contact, avec le bouton de démonstration. Section seulement, sans formulaire ni adresse : le formulaire est
// VIT-02, qui attend les textes légaux et le nom de domaine (Q-11).
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import Accroche from '../socle/Accroche.astro';
import Apparition from '../socle/Apparition.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import Logo from '../socle/Logo.astro';
import { traductions } from '../../i18n/index.js';
import { cheminContact } from '../../i18n/langues.js';

interface Props {
  t: (cle: string) => any;
  langue: string;
}

const { t, langue } = Astro.props;
const commun = traductions(langue, 'commun');
---
<Section id="contact" ton="sombre" etiquette="contact-titre">
  <Apparition>
    <div class="contenu">
      <Logo variante="icone" class="contact-logo" />
      <Titre id="contact-titre">{t('contact.titre')}</Titre>
      <Accroche>{t('contact.texte')}</Accroche>
      <BoutonPrincipal href={cheminContact(langue)}>{commun('navigation.demonstration')}</BoutonPrincipal>
    </div>
  </Apparition>
</Section>

<style>
  .contenu { display: grid; gap: var(--espace-3); justify-items: center; }
  :global(.contact-logo) { inline-size: 5rem; border-radius: 1.1rem; box-shadow: 0 0 0 1px rgb(166 202 238 / 25%); }
</style>
