---
// Accueil, section 1 : ouverture. Le logo à l'horloge (ses aiguilles tournent au chargement et au
// survol), le nom du produit, une phrase sur ce que fait Planner, puis « Demander une démonstration » et « Voir les applications ».
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import Accroche from '../socle/Accroche.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import Logo from '../socle/Logo.astro';
import { traductions } from '../../i18n/index.js';
import { cheminContact } from '../../i18n/langues.js';

interface Props {
  t: (cle: string) => any;
  langue: string;
}

const { t, langue } = Astro.props;
const commun = traductions(langue, 'commun');
---
<Section ton="clair" plein etiquette="ouverture-titre">
  <Logo anime class="ouverture-logo" />
  <Titre niveau={1} taille="geant" id="ouverture-titre">{t('ouverture.titre')}</Titre>
  <Accroche forte>{t('ouverture.accroche')}</Accroche>
  <div class="actions">
    <BoutonPrincipal href={cheminContact(langue)}>{commun('navigation.demonstration')}</BoutonPrincipal>
    <BoutonPrincipal href="#applications" variante="contour">{commun('navigation.voirLesApplications')}</BoutonPrincipal>
  </div>
</Section>

<style>
  :global(.ouverture-logo) { inline-size: clamp(9rem, 6rem + 12vw, 15rem); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--espace-2); }
</style>
