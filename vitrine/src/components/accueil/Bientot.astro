---
// Accueil, section 7 : les modules à venir (vie scolaire, familles, frais), chacun marqué « Bientôt »,
// sans date. Rien n'y est présenté comme disponible.
import { ClipboardList, Users, Wallet } from 'lucide-react';
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import Accroche from '../socle/Accroche.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import Apparition from '../socle/Apparition.astro';
import { chemin } from '../../i18n/langues.js';

interface Props {
  t: (cle: string) => any;
  langue: string;
}

const { t, langue } = Astro.props;
const modules: { titre: string; texte: string }[] = t('bientot.modules');
const ICONES = [ClipboardList, Users, Wallet];
---
<Section id="bientot" ton="clair" large etiquette="bientot-titre">
  <Apparition>
    <div class="entete">
      <Titre id="bientot-titre" surtitre={t('bientot.surtitre')}>{t('bientot.titre')}</Titre>
      <Accroche>{t('bientot.texte')}</Accroche>
    </div>
  </Apparition>
  <ul class="modules">
    {modules.map((module, i) => {
      const Icone = ICONES[i];
      return (
        <li>
          <Apparition delai={i * 0.12}>
            <div class="module">
              <span class="badge">{t('bientot.badge')}</span>
              <Icone aria-hidden="true" size={32} strokeWidth={1.25} />
              <h3>{module.titre}</h3>
              <p>{module.texte}</p>
            </div>
          </Apparition>
        </li>
      );
    })}
  </ul>
  <BoutonPrincipal href={chemin(langue, 'bientot')} variante="lien">{t('bientot.lien')}</BoutonPrincipal>
</Section>

<style>
  .entete { display: grid; gap: var(--espace-3); justify-items: center; }
  .modules { display: grid; gap: var(--espace-3); inline-size: 100%; }
  .module { display: grid; justify-items: start; gap: var(--espace-1); block-size: 100%; padding: var(--espace-4) var(--espace-3); border: 1px solid var(--gris-trait); border-radius: var(--rayon-grand); text-align: start; }
  .module :global(svg) { color: var(--bleu); margin-block: var(--espace-2) var(--espace-1); }
  .badge { padding: 0.2rem 0.7rem; border-radius: var(--rayon-pilule); background: var(--gris-fond); color: var(--bleu-nuit); font-size: 0.8125rem; font-weight: 600; }
  h3 { font-size: 1.3125rem; font-weight: 650; }
  p { color: var(--gris-texte); }

  @media (min-width: 56rem) {
    .modules { grid-template-columns: repeat(3, 1fr); }
  }
</style>
