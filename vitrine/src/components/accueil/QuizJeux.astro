---
// Accueil, section 4 : les quiz en direct et les jeux. Section claire ; téléphone d'abord, texte ensuite.
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import Accroche from '../socle/Accroche.astro';
import BoutonPrincipal from '../socle/BoutonPrincipal.astro';
import Apparition from '../socle/Apparition.astro';
import CadreAppareil from '../socle/CadreAppareil.astro';
import Duo from '../socle/Duo.astro';
import IllustrationQuiz from './IllustrationQuiz.astro';
import { chemin, pageModule } from '../../i18n/langues.js';

interface Props {
  t: (cle: string) => any;
  langue: string;
}

const { t, langue } = Astro.props;
---
<Section id="quiz" ton="clair" large etiquette="quiz-titre">
  <Duo inverse>
    <Apparition slot="texte">
      <div class="texte">
        <Titre id="quiz-titre" surtitre={t('quiz.surtitre')}>{t('quiz.titre')}</Titre>
        <Accroche>{t('quiz.texte')}</Accroche>
        <BoutonPrincipal href={chemin(langue, pageModule('quizEtJeux'))} variante="lien">{t('quiz.lien')}</BoutonPrincipal>
      </div>
    </Apparition>
    <Apparition delai={0.15}>
      <div class="telephone">
        <CadreAppareil type="telephone" label={t('quiz.illustration.label')}>
          <IllustrationQuiz t={t} />
        </CadreAppareil>
      </div>
    </Apparition>
  </Duo>
</Section>

<style>
  .texte { display: grid; gap: var(--espace-3); justify-items: inherit; }
  .telephone { display: grid; justify-items: center; }
</style>
