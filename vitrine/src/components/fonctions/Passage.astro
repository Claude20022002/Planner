---
// Cinq lignes « avant → avec Planner ». Les phrases viennent des textes du rôle.
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';

interface Props {
  titre: string;
  avant: string;
  avec: string;
  lignes: { avant: string; avec: string }[];
}

const { titre, avant, avec, lignes } = Astro.props;
---
<Section id="passage" large etiquette="passage-titre">
  <Titre id="passage-titre" taille="moyen">{titre}</Titre>
  <ol class="lignes">
    {lignes.map((ligne) => (
      <li class="ligne">
        <p class="cote"><span>{avant}</span>{ligne.avant}</p>
        <p class="cote"><span>{avec}</span>{ligne.avec}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .lignes { display: grid; gap: var(--espace-2); inline-size: 100%; margin: 0; padding: 0; list-style: none; text-align: start; }
  .ligne { display: grid; gap: var(--espace-3); padding: var(--espace-3); border-radius: var(--rayon-grand); background: var(--gris-fond); }
  .cote { display: grid; gap: var(--espace-1); margin: 0; }
  .cote span { font-size: var(--texte-petit); font-weight: 650; color: var(--bleu); }

  @media (min-width: 40rem) {
    .ligne { grid-template-columns: 1fr 1fr; }
  }
</style>
