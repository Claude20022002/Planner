---
// Ouverture d'une page de fonction : surtitre, titre géant (le h1 de la page) et accroche, centrés.
// Une idée par page, dite en une phrase ; le reste de la page la détaille section par section.
import Section from '../socle/Section.astro';
import Titre from '../socle/Titre.astro';
import Accroche from '../socle/Accroche.astro';
import Apparition from '../socle/Apparition.astro';

interface Props {
  surtitre: string;
  titre: string;
  accroche: string;
  ton?: 'clair' | 'gris' | 'sombre';
}

const { surtitre, titre, accroche, ton = 'clair' } = Astro.props;
---
<Section ton={ton} etiquette="page-titre">
  <Apparition>
    <div class="ouverture">
      <Titre niveau={1} taille="geant" id="page-titre" surtitre={surtitre}>{titre}</Titre>
      <Accroche>{accroche}</Accroche>
      <div class="actions"><slot name="actions" /></div>
    </div>
  </Apparition>
</Section>

<style>
  .ouverture { display: grid; gap: var(--espace-3); justify-items: center; padding-block-start: var(--espace-3); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--espace-2); width: 100%; }
  .actions:empty { display: none; }
</style>
