---
// Ouverture d'une page de fonction, de rôle ou de texte : surtitre, titre géant (le h1 de la page), accroche, boutons facultatifs.
// Mise en page de VIT-23 (socle/OuverturePage) : une illustration à côté si la page en donne une, un passage du titre en relief.
import OuverturePage from '../socle/OuverturePage.astro';

interface Props {
  surtitre: string;
  titre: string;
  accroche: string;
  relief?: string;
  image?: string;
  ton?: 'clair' | 'gris' | 'sombre';
}

const { surtitre, titre, accroche, relief, image, ton = 'clair' } = Astro.props;
---
<OuverturePage id="page-titre" ton={ton} surtitre={surtitre} titre={titre} relief={relief} accroche={accroche} image={image}>
  {Astro.slots.has('actions') && <Fragment slot="actions"><slot name="actions" /></Fragment>}
</OuverturePage>
